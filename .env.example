# Copy to .env and fill in real values. .env is gitignored — never commit it.
# All values here are placeholders; the app reads them from the environment.

# Google Gemini (optional single structured requirement-extraction call behind
# the router's confidence gate). Without it the router stays fully deterministic.
GEMINI_API_KEY=

# Razorpay TEST-mode keys (never production keys in dev).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SQLite by default (no migrations). A fresh DB starts with an EMPTY merchant
# catalog — products are added at runtime from SERP discovery (EXT-xxx items).
DATABASE_URL=sqlite:///./growthmate.db

# Optional: live external-product discovery. Without it discovery.py uses the
# offline mock catalog and stays fully functional offline.
SERPAPI_KEY=

# Guardrail ALLOW path signs an HMAC mandate with this secret (Rev 3, Phase 4).
# app.main refuses to boot without it. Generate your own: `node -e
# 'console.log(require("crypto").randomBytes(32).toString("hex"))'`
MANDATE_SECRET=

# Cascade router (Rev 3, Phase 1). Latency optimizer, never a money authority.
# CASCADE_ENABLED=false reproduces Rev-2 exactly (every turn falls through).
CASCADE_ENABLED=true
CASCADE_TIER1_THRESHOLD=0.70
CASCADE_TIER2_THRESHOLD=0.80

# Semantic external cache (LLD §8) tuning.
SEMANTIC_CACHE_TTL_SECONDS=900
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.62

# Catalog RAG index (Rev 3, Phase 2) — deterministic on-disk k-NN index.
CATALOG_INDEX_PATH=growthmate.catalog_index.json
CATALOG_INDEX_MIN_SCORE=0.10

# buyer_agent.py demo only (standalone script, separate process).
BUYER_BASE_URL=http://127.0.0.1:8000
BUYER_SESSION_ID=sess-buyer-demo